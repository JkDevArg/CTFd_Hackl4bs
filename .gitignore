**/logs/*.log

# SSL certificates generados por Hestia / Let's Encrypt
ssl/
*.pem
*.key
*.crt
*.p12

# Whaley: base de datos local y logs de instancias
whaley/data/
whaley/logs/
whaley/*.db

# Challenges binarios / archivos grandes de retos
