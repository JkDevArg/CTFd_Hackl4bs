# ── Whaley Instancer ─────────────────────────────────────────────────────────
# Copia este archivo a .env y completa los valores reales

HOST=0.0.0.0
PORT=8001
INSTANCER_PORT=8001
DEBUG=false

AUTH_MODE=ctfd
CTFD_URL=http://ctfd-ctfd-1:8000
CTFD_API_KEY=

ADMIN_KEY=
ADMIN_RATE_LIMIT=150

MAX_INSTANCES_PER_USER=3
MAX_INSTANCES_PER_TEAM=5
INSTANCE_TIMEOUT=600

PORT_RANGE_START=10000
PORT_RANGE_END=60000

CHALLENGES_DIR=/challenges
PUBLIC_HOST=auto

TRUSTED_PROXIES=127.0.0.1,::1

DATABASE_URL=sqlite+aiosqlite:///./data/whaley.db
DATA_DIR=/app/data
REDIS_URL=redis://redis:6379/0

NETWORK_ISOLATION_ENABLED=true
NETWORK_ICC_DISABLED=true
NETWORK_PREFIX=hackl4bs

DYNAMIC_FLAGS_ENABLED=true
FLAG_PREFIX=H4L

FORENSICS_AUTO_CAPTURE=false
FORENSICS_MAX_SIZE_MB=5
FORENSICS_TAIL_LINES=1000
FORENSICS_RETENTION_HOURS=168
FORENSICS_COMPRESSION=true

DISCORD_WEBHOOK_URL=
